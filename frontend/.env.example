VITE_API_BASE_URL=http://localhost:8000

# Datadog RUM + Browser Logs — leave blank to run without them (a console warning
# will note this). Get these from Datadog > Organization Settings > Application Keys
# (RUM application) and Client Tokens.
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_SERVICE=the-byte-stop
VITE_DATADOG_ENV=sandbox
# Bump this on every release you want tracked separately in RUM. Must match the
# --release-version passed to `npm run sourcemaps:upload`, or RUM can't unminify stacks.
VITE_DATADOG_VERSION=1.0.0
